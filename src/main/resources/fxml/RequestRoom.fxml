<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.RequestRoomController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Request Ruangan Meeting" />
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- FORM INPUT -->
        <VBox prefWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-background-radius: 5;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Form Request Ruangan Meeting" />
            <Separator />
            
            <HBox spacing="15.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Tanggal Booking"><font><Font name="System Bold" size="12.0" /></font></Label>
                    <DatePicker fx:id="dpDate" prefHeight="35.0" prefWidth="Infinity" promptText="dd/mm/yyyy" />
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Ruangan"><font><Font name="System Bold" size="12.0" /></font></Label>
                    <ComboBox fx:id="cbRoom" prefHeight="35.0" prefWidth="Infinity" promptText="-Pilih-" />
                </VBox>
            </HBox>
            
            <HBox spacing="15.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Jam Mulai"><font><Font name="System Bold" size="12.0" /></font></Label>
                    <ComboBox fx:id="cbStartTime" prefHeight="35.0" prefWidth="Infinity" promptText="HH:mm" />
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Jam Selesai"><font><Font name="System Bold" size="12.0" /></font></Label>
                    <ComboBox fx:id="cbEndTime" prefHeight="35.0" prefWidth="Infinity" promptText="HH:mm" />
                </VBox>
            </HBox>
            
            <HBox spacing="15.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Nama Peminjam"><font><Font name="System Bold" size="12.0" /></font></Label>
                    <TextField fx:id="txtPic" prefHeight="35.0" promptText="Masukkan nama" />
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Divisi"><font><Font name="System Bold" size="12.0" /></font></Label>
                    <TextField fx:id="txtDivision" prefHeight="35.0" promptText="Masukkan divisi" />
                </VBox>
            </HBox>
            
            <HBox spacing="15.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Jabatan"><font><Font name="System Bold" size="12.0" /></font></Label>
                    <TextField fx:id="txtPosition" prefHeight="35.0" promptText="Masukkan jabatan" />
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Jumlah Orang"><font><Font name="System Bold" size="12.0" /></font></Label>
                    <TextField fx:id="txtParticipants" prefHeight="35.0" promptText="Contoh: 10" />
                </VBox>
            </HBox>
            
            <VBox spacing="5.0">
                <Label text="Keperluan"><font><Font name="System Bold" size="12.0" /></font></Label>
                <TextArea fx:id="txtPurpose" prefRowCount="3" promptText="Tuliskan tujuan meeting..." />
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
                <Button onAction="#handleClear" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Kembali" />
                <Button onAction="#handleSave" prefHeight="35.0" prefWidth="100.0" styleClass="btn-primary" text="Simpan" />
            </HBox>
        </VBox>

        <!-- DATA TABEL (JADWAL HARI INI/AKTIF) -->
        <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-background-radius: 5;" spacing="10.0">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Daftar Booking Terbaru" />
            <TableView fx:id="tableBooking" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRoom" prefWidth="150.0" text="Ruangan" />
                    <TableColumn fx:id="colTime" prefWidth="150.0" text="Waktu" />
                    <TableColumn fx:id="colPic" prefWidth="120.0" text="Peminjam" />
                    <TableColumn fx:id="colPurpose" prefWidth="200.0" text="Keperluan" />
                    <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
