<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.RequestRoomController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Request Ruangan Meeting" />
    </HBox>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-background-radius: 5;">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Form Request Ruangan Meeting" />
        <Separator />
        
        <VBox spacing="5.0">
            <Label text="Ruangan"><font><Font name="System Bold" size="12.0" /></font></Label>
            <ComboBox fx:id="cbRoom" prefHeight="35.0" prefWidth="Infinity" promptText="-Pilih Ruangan-" />
        </VBox>

        <HBox spacing="30.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Dari"><font><Font name="System Bold" size="12.0" /></font></Label>
                <HBox spacing="10.0">
                    <DatePicker fx:id="dpDate" prefHeight="35.0" promptText="dd/mm/yyyy" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <ComboBox fx:id="cbStartTime" prefHeight="35.0" prefWidth="100.0" promptText="--:--" />
                </HBox>
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Sampai"><font><Font name="System Bold" size="12.0" /></font></Label>
                <HBox spacing="10.0">
                    <DatePicker fx:id="dpEndDate" prefHeight="35.0" promptText="dd/mm/yyyy" HBox.hgrow="ALWAYS" maxWidth="Infinity" disable="true" />
                    <ComboBox fx:id="cbEndTime" prefHeight="35.0" prefWidth="100.0" promptText="--:--" />
                </HBox>
                <Label style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" text="* Notes: Terdapat waktu extra sebanyak 15 menit untuk pembersihan" />
            </VBox>
        </HBox>
        
        <HBox spacing="30.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Nama Peminjam"><font><Font name="System Bold" size="12.0" /></font></Label>
                <TextField fx:id="txtPic" prefHeight="35.0" />
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Divisi"><font><Font name="System Bold" size="12.0" /></font></Label>
                <TextField fx:id="txtDivision" prefHeight="35.0" />
            </VBox>
        </HBox>
        
        <VBox spacing="5.0">
            <Label text="Keperluan"><font><Font name="System Bold" size="12.0" /></font></Label>
            <TextArea fx:id="txtPurpose" prefRowCount="4" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 20 0 0 0;">
            <Button onAction="#handleSave" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #5d87ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Simpan" />
            <Button onAction="#handleClear" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #8c98a4; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Kembali" />
        </HBox>
    </VBox>
</VBox>
