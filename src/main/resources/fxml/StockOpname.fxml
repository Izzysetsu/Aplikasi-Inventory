<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.StockOpnameController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Stock Opname (Monitoring &amp; Penyesuaian Fisik)" />

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- TABEL DATA -->
        <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Pencarian:" />
                <TextField fx:id="txtSearch" prefHeight="30.0" prefWidth="250.0" promptText="Ketik nama atau kategori..." style="-fx-background-radius: 15;" />
                <Button onAction="#handleRefresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Refresh Data" />
            </HBox>
            
            <TableView fx:id="tableStock" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colBarcode" prefWidth="100.0" text="Barcode" />
                    <TableColumn fx:id="colName" prefWidth="200.0" text="Nama Barang" />
                    <TableColumn fx:id="colCategory" prefWidth="100.0" text="Kategori" />
                    <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
                    <TableColumn fx:id="colQtySystem" prefWidth="80.0" text="Qty Sistem" />
                    <TableColumn fx:id="colUnit" prefWidth="80.0" text="Satuan" />
                </columns>
            </TableView>
        </VBox>

        <!-- PANEL PENYESUAIAN -->
        <VBox spacing="15.0" prefWidth="300.0" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" text="Panel Penyesuaian Stok" />
            
            <VBox spacing="5.0">
                <Label text="Barang Terpilih:" style="-fx-font-weight: bold;" />
                <Label fx:id="lblSelectedItem" text="Belum ada yang dipilih" wrapText="true" style="-fx-text-fill: #7f8c8d;" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Qty Sistem:" style="-fx-font-weight: bold;" />
                <Label fx:id="lblQtySystem" text="0" style="-fx-font-size: 18px; -fx-text-fill: #34495e;" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Qty Fisik (Aktual):" style="-fx-font-weight: bold;" />
                <TextField fx:id="txtQtyPhysical" prefHeight="35.0" promptText="Masukkan Qty Aktual" disable="true" />
                <Label style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;" text="*Masukkan jumlah fisik sebenarnya saat ini." wrapText="true" />
            </VBox>

            <Button fx:id="btnAdjust" disable="true" maxWidth="Infinity" onAction="#handleAdjust" prefHeight="40.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Sesuaikan Stok" />
        </VBox>
    </HBox>
</VBox>
