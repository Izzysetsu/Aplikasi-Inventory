<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.TransactionOutboundController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Data Barang Keluar (Mutasi / Pemindahan Stok)" />

    <VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;">
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3498db;" text="Form Data Keluar" />
        
        <GridPane hgap="30.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" />
                <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>
            <children>
                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Barang Terpilih" style="-fx-text-fill: #7f8c8d;" />
                    <TextField fx:id="txtSelectedAsset" prefHeight="35.0" promptText="Pilih barang dari tabel di bawah" disable="true" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                </VBox>
                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Lokasi Tujuan" style="-fx-text-fill: #7f8c8d;" />
                    <ComboBox fx:id="cbLocation" prefHeight="35.0" prefWidth="Infinity" promptText="Pilih Lokasi Tujuan" />
                </VBox>

                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Jumlah (Qty)" style="-fx-text-fill: #7f8c8d;" />
                    <TextField fx:id="txtQty" prefHeight="35.0" promptText="Masukkan jumlah keluar" />
                </VBox>
                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Tanggal Keluar" style="-fx-text-fill: #7f8c8d;" />
                    <DatePicker fx:id="dpOutboundDate" prefHeight="35.0" prefWidth="Infinity" />
                </VBox>
                
                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                    <Label text="Keterangan / Tujuan" style="-fx-text-fill: #7f8c8d;" />
                    <TextField fx:id="txtPurpose" prefHeight="35.0" promptText="Contoh: Dipindahkan ke Cabang B" />
                </VBox>
            </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button onAction="#handleClear" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Batal" />
            <Button fx:id="btnSave" disable="true" onAction="#handleSave" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Proses Barang Keluar" />
        </HBox>
    </VBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" spacing="10.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Pilih Barang dari Master:" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtSearch" prefHeight="30.0" prefWidth="300.0" promptText="Cari nama atau barcode..." style="-fx-background-radius: 15;" />
        </HBox>

        <TableView fx:id="tableAsset" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBarcode" prefWidth="120.0" text="Barcode" />
                <TableColumn fx:id="colName" prefWidth="250.0" text="Nama Barang" />
                <TableColumn fx:id="colCategory" prefWidth="150.0" text="Kategori" />
                <TableColumn fx:id="colQty" prefWidth="80.0" text="Stok" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>
        <Label style="-fx-font-size: 12px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;" text="*Klik baris tabel untuk memilih barang yang akan dikeluarkan." />
    </VBox>
</VBox>
