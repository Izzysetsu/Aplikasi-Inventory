<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.MasterRoomController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Data Ruangan Meeting" />
    </HBox>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-background-radius: 5;">
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Form Ruangan Meeting" />
        <Separator />
        
        <HBox spacing="30.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Nama Ruangan">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <TextField fx:id="txtName" prefHeight="35.0" promptText="Contoh: Ruang Meeting A" />
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Keterangan">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                <TextField fx:id="txtDescription" prefHeight="35.0" promptText="Contoh: Lantai 2, Ada Proyektor" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 20 0 0 0;">
            <Button onAction="#handleClear" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #8c98a4; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Batal" />
            <Button fx:id="btnDelete" disable="true" onAction="#handleDelete" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Hapus" />
            <Button fx:id="btnUpdate" disable="true" onAction="#handleUpdate" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Perbarui" />
            <Button fx:id="btnSave" onAction="#handleSave" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #5d87ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Simpan" />
        </HBox>
    </VBox>

    <!-- DATA TABEL -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0); -fx-background-radius: 5;">
        <TableView fx:id="tableRoom" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" prefWidth="250.0" text="Nama Ruangan" />
                <TableColumn fx:id="colDescription" prefWidth="400.0" text="Keterangan" />
            </columns>
        </TableView>
    </VBox>
</VBox>
