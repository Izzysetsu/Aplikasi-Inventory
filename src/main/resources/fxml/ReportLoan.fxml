<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.ReportLoanController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Laporan Peminjaman" />
    </HBox>

    <HBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-alignment: center-left;">
        <Label text="Filter:" style="-fx-font-weight: bold;" />
        <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="200.0" promptText="🔍 Cari Nama/PIC/Barang..." />
        <ComboBox fx:id="cbCategory" prefHeight="35.0" prefWidth="120.0" promptText="Jenis" />
        <ComboBox fx:id="cbStatus" prefHeight="35.0" prefWidth="120.0" promptText="Status" />
        <DatePicker fx:id="dpStartDate" prefHeight="35.0" prefWidth="130.0" promptText="Tgl Awal" />
        <DatePicker fx:id="dpEndDate" prefHeight="35.0" prefWidth="130.0" promptText="Tgl Akhir" />
        <Button onAction="#handleFilter" prefHeight="35.0" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Terapkan" />
        <Button onAction="#handleResetFilter" prefHeight="35.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Reset" />
    </HBox>

    <!-- CARD TABEL -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5;">
        <TableView fx:id="tableLoan" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPic" prefWidth="150.0" text="Nama PIC" />
                <TableColumn fx:id="colDiv" prefWidth="100.0" text="Divisi" />
                <TableColumn fx:id="colAsset" prefWidth="200.0" text="Asset (Barcode)" />
                <TableColumn fx:id="colLoc" prefWidth="100.0" text="Lokasi" />
                <TableColumn fx:id="colQty" prefWidth="70.0" text="Qty" />
                <TableColumn fx:id="colLoanDate" prefWidth="100.0" text="Tgl Pinjam" />
                <TableColumn fx:id="colReturnDate" prefWidth="100.0" text="Tgl Kembali" />
                <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
            </columns>
        </TableView>
        
        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 15 0 0 0;">
            <Button onAction="#handleExport" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="📥 Export Excel" />
        </HBox>
    </VBox>
</VBox>