<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.ListPeminjamanController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="List Peminjaman Aktif (ASET)" />

    <!-- FORM PENGEMBALIAN (ATAS) -->
    <VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;">
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #5d87ff;" text="Form Pengembalian Barang" />
        
        <GridPane hgap="30.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" />
                <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>
            <children>
                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label style="-fx-text-fill: #7f8c8d;" text="Peminjam / PIC" />
                    <Label fx:id="lblPicName" text="-" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;" />
                </VBox>
                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label style="-fx-text-fill: #7f8c8d;" text="Barang Dipinjam" />
                    <Label fx:id="lblAsset" text="Belum ada yang dipilih" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;" />
                </VBox>
                
                <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label style="-fx-text-fill: #7f8c8d;" text="Tanggal Pinjam" />
                    <Label fx:id="lblLoanDate" text="-" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;" />
                </VBox>
                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label style="-fx-text-fill: #7f8c8d;" text="Tanggal Pengembalian" />
                    <DatePicker fx:id="dpReturnDate" prefHeight="35.0" prefWidth="Infinity" disable="true" />
                </VBox>
            </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button onAction="#initialize" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #8c98a4; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Batal" />
            <Button fx:id="btnReturn" disable="true" onAction="#handleReturn" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #5d87ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Kembalikan Barang" />
        </HBox>
    </VBox>

    <!-- TABEL DATA (BAWAH) -->
    <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Cari Transaksi:" />
            <TextField fx:id="txtSearch" prefHeight="30.0" prefWidth="300.0" promptText="Ketik nama peminjam / barang..." style="-fx-background-radius: 15;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRefresh" prefHeight="30.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🔄 Refresh Data" />
        </HBox>
        
        <TableView fx:id="tableLoan" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPicName" prefWidth="150.0" text="Peminjam (PIC)" />
                <TableColumn fx:id="colDivision" prefWidth="120.0" text="Divisi" />
                <TableColumn fx:id="colAsset" prefWidth="250.0" text="Barang Dipinjam" />
                <TableColumn fx:id="colLoanDate" prefWidth="120.0" text="Tanggal Pinjam" />
                <TableColumn fx:id="colPurpose" prefWidth="150.0" text="Keperluan" />
            </columns>
        </TableView>
    </VBox>
</VBox>
