<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.ReportAssetController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Laporan Barang (Riwayat Mutasi &amp; Peminjaman)" />
    </HBox>

    <HBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-alignment: center-left;">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Pencarian:" />
        <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="200.0" promptText="Cari nama barang / lokasi..." />
        
        <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" text="Periode:" />
        <DatePicker fx:id="dpStartDate" prefHeight="35.0" prefWidth="130.0" promptText="Tgl Awal" />
        <Label text="-" />
        <DatePicker fx:id="dpEndDate" prefHeight="35.0" prefWidth="130.0" promptText="Tgl Akhir" />
        
        <Button onAction="#handleFilter" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #5d87ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Cari" />
        <Button onAction="#handleReset" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #8c98a4; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Reset" />
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" spacing="10.0">
        <TableView fx:id="tableOutbound" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="120.0" text="Tanggal" />
                <TableColumn fx:id="colBarcode" prefWidth="120.0" text="Barcode" />
                <TableColumn fx:id="colAsset" prefWidth="200.0" text="Nama Barang" />
                <TableColumn fx:id="colTransType" prefWidth="150.0" text="Jenis Transaksi" />
                <TableColumn fx:id="colQty" prefWidth="60.0" text="Qty" />
                <TableColumn fx:id="colLocation" prefWidth="150.0" text="Lokasi" />
                <TableColumn fx:id="colPurpose" prefWidth="250.0" text="Keterangan / Tujuan" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
            <Button onAction="#handleExportExcel" prefHeight="40.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📥 Export Excel" />
        </HBox>
    </VBox>
</VBox>
