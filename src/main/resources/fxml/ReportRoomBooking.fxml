<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventory.controller.ReportRoomBookingController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Laporan Peminjaman Ruangan" />
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" spacing="15.0">
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <Label text="Filter Status:" />
            <ComboBox fx:id="cbStatusFilter" prefWidth="150.0" promptText="Semua Status" />
            <Button onAction="#handleFilter" prefHeight="35.0" style="-fx-background-color: #5d87ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Terapkan Filter" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleExportExcel" prefHeight="35.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📥 Export Excel" />
        </HBox>
        
        <TableView fx:id="tableBooking" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRoom" prefWidth="120.0" text="Ruangan" />
                <TableColumn fx:id="colStartTime" prefWidth="130.0" text="Mulai" />
                <TableColumn fx:id="colEndTime" prefWidth="130.0" text="Selesai" />
                <TableColumn fx:id="colPic" prefWidth="120.0" text="Peminjam" />
                <TableColumn fx:id="colDivision" prefWidth="150.0" text="Divisi" />
                <TableColumn fx:id="colPurpose" prefWidth="150.0" text="Keperluan" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
            </columns>
        </TableView>
    </VBox>
</VBox>
